<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin">

        <TableLayout
                android:id="@+id/fragmet_price_show_table"
                android:layout_width="0dp"
                android:paddingBottom="32dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:stretchColumns="1,2">

            <TableRow>
                <TextView
                        android:text="@string/title_date"
                        android:gravity="start"
                        android:padding="3dp"
                        android:textStyle="bold"/>
                <TextView
                        android:text="@string/title_grocery_store"
                        android:padding="3dp"
                        android:gravity="start"
                        android:textStyle="bold"/>
                <TextView
                        android:text="@string/title_price"
                        android:gravity="end"
                        android:padding="3dp"
                        android:textStyle="bold"/>
            </TableRow>
            <TableRow
                android:id="@+id/fragment_price_show_data_template_row">
                <TextView
                        android:text="17.04.2025"
                        android:gravity="start"
                        android:padding="3dp"/>
                <TextView
                        android:text="BigShop City"
                        android:padding="3dp"
                        android:gravity="start"/>
                <TextView
                        android:text="3,5 / g"
                        android:gravity="end"
                        android:padding="3dp"/>
            </TableRow>

        </TableLayout>

        <Button
                android:id="@+id/fragmet_price_show_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fragmet_price_show_table"
                android:text="@string/action_add"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <Button
                android:id="@+id/fragmet_price_show_show_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fragmet_price_show_table"
                android:text="@string/action_show_all"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/fragmet_price_show_chart"
                app:layout_constraintTop_toBottomOf="@id/fragmet_price_show_show_all"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="match_parent"
                android:layout_height="200dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>